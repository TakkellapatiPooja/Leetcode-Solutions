class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        int m=matrix.length;
        int n=matrix[0].length;

        int l=0;
        int h=(m*n)-1;
        while(l<=h){
            int mid= (l+h)/2;
            int row=mid/n;
            int col=mid%n;

            int val=matrix[row][col];
            if(val==target){
                return true;
            }else if(target<val){
                h=mid-1;
            }else{
                l=mid+1;
            }
        }
        return false;
    }
}

class Solution {
    public int longestConsecutive(int[] nums) {
        HashSet<Integer> set=new HashSet<>();
        for(int i : nums){
            set.add(i);
        }
        int lo=0;
        for(int num : set){
            if(!set.contains(num-1)){
                int pre=num;
                int le=1;
            while(set.contains(pre+1)){
                le++;
                pre++;
            }
            lo=Math.max(lo,le);    

            
            }
        }
        return lo;
    }
}
